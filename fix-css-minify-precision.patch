From 069f5533e7aa25aca31a1a7cee59bb81f5b7889e Mon Sep 17 00:00:00 2001
From: Karan <karan@robosathi.com>
Date: Tue, 20 Oct 2026 21:14:46 +0000
Subject: [PATCH] Fix sidebar font-size: stop CSS minifier truncating numbers
 to 1 significant digit

hugo.yaml set minify.tdewolff.css.precision: 1. In tdewolff/minify, precision
is significant digits, not decimals, so production (--minify) builds turned
14.5px into 10px and line-height 1.4 into 1 (plus rgba channels, rem sizes,
etc. site-wide). Dev builds are not minified, hence correct locally.
precision: 0 keeps full precision.
---
 hugo.yaml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/hugo.yaml b/hugo.yaml
index 0ee21b5..608bd1f 100644
--- a/hugo.yaml
+++ b/hugo.yaml
@@ -245,7 +245,10 @@ minify:
       keepDefaultAttrVals: false
       keepWhitespace: false
     css:
-      precision: 1
+      # 0 = keep full numeric precision. Any positive value is *significant
+      # digits*, not decimals: precision: 1 turned 14.5px into 10px and
+      # line-height 1.4 into 1 in the minified (production-only) CSS.
+      precision: 0
     js:
       keepVarNames: false
 
-- 
